#!/bin/sh
# Every test, in one command.
#
# The engine, the brief, the index and the runner are stdlib and run anywhere:
#   python3 -m unittest test_ccwho test_runner test_brief test_index test_setup \
#                       test_contract
#
# The UI tests need Textual. uv fetches and caches it from the header in
# ccwho_ui.py, so there is nothing to install - but if it cannot, the UI tests
# FAIL rather than skip. "OK (skipped=12)" while the screen is broken is a green
# light for nothing.
set -e
cd "$(dirname "$0")"

CORE="test_ccwho test_runner test_brief test_index test_setup test_contract"
echo "== engine, brief, index, setup, runner (stdlib) =="
python3 -m unittest $CORE "$@"

echo
echo "== ui (textual, via uv) =="
if ! command -v uv >/dev/null 2>&1; then
  echo "uv is not installed, so the UI tests cannot run: brew install uv" >&2
  exit 1
fi
exec uv run --quiet --with "textual>=8.0,<9" python -m unittest test_ui "$@"
